{
  "site": {
    "title": "Ani",
    "author": "Ani",
    "baseURL": "https://aniruddhapisolkar.github.io/homepage",
    "description": "A personal archive of writing, work, and ideas.",
    "footer": "An evolving collection of work and ideas.",
    "headExtra": "<link rel=\"stylesheet\" href=\"/homepage/static/graph-controls.css\"><script defer src=\"/homepage/static/graph-controls.js\"></script>"
  },
  "theme": {
    "preset": "quiet",
    "fontHeading": "Obel Mono",
    "fontBody": "Obel Mono",
    "fontMono": "Obel Mono",
    "accent": "#8b4a2d",
    "background": {
      "light": "#f8f0e3",
      "dark": "#241b16"
    },
    "navStyle": "sticky",
    "navActiveStyle": "underlined",
    "listColumns": 1,
    "fonts": [
      {
        "family": "Obel Mono",
        "file": "static/fonts/obel-mono/ObelMono-Roman.woff2",
        "weight": "100 900",
        "style": "normal",
        "display": "swap"
      },
      {
        "family": "Obel Mono",
        "file": "static/fonts/obel-mono/ObelMono-Italic.woff2",
        "weight": "100 900",
        "style": "italic",
        "display": "swap"
      }
    ]
  },
  "features": {
    "graph": true,
    "toc": true,
    "search": true,
    "wikilinks": true,
    "backlinks": true,
    "rss": true,
    "sharing": false
  },
  "navigation": {
    "mode": "automatic",
    "includeTags": false
  },
  "build": {
    "outputDir": "_site",
    "ignore": [
      "README.md",
      "drafts",
      "*.draft.md",
      "scripts",
      ".github"
    ]
  }
}
